# =========================
# Large offline map assets
# =========================
# If offline tiles are too large for GitHub, ignore them here
# or use GitHub LFS / external storage.
# android/app/src/main/assets/offline_tiles/**/*.pbf
# android/app/src/main/assets/offline_tiles/**/*.png
# android/app/src/main/assets/offline_tiles/**/*.mbtiles