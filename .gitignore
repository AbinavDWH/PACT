__pycache__/
*.py[cod]
# Secrets. Broad by design: a leaked Atlas URI or Groq key is not recoverable
# by editing history after the fact.
.env
.env.*
*.env
!.env.example
atlas-credentials.env
secrets/
node_modules/
.next/

# Android / Gradle. `build/` matches at any depth; the trailing slash keeps it
# to directories, so a source file named `build` is unaffected.
build/
.gradle/
local.properties
*.apk
*.aab
.cxx/

# Firebase SERVER key. Lets anyone send push as this project -- a real secret,
# unlike google-services.json which ships inside every APK.
service-account.json
firebase-service-account.json
**/service-account*.json

# Cached OpenStreetMap tiles. Regenerable with POST /api/v1/tiles/prefetch,
# and megabytes of binary that would bloat every clone.
backend/tile_cache/
