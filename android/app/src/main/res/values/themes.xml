<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this exists only so the window has a
         sensible background and no ActionBar flashes before the first frame.

         Dark, matching the web console, which is dark-only by design: the two
         surfaces are used side by side and a white flash between the launcher
         and the first Compose frame was the one moment the app did not look
         like the rest of the system. -->
    <style name="Theme.Pact" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pact_bg</item>
        <item name="android:statusBarColor">@color/pact_bg</item>
        <item name="android:navigationBarColor">@color/pact_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
