# Copy to backend/.env and fill in. Never commit the real .env -- it is
# git-ignored by the *.env rule in the repo root .gitignore.

# --- MongoDB Atlas (agents.md section 4) -----------------------------------
# Atlas -> Connect -> Drivers -> Python. Replace <db_password> with the real
# password from Database Access.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
MONGO_DB=pact

# --- Groq (agents.md section 5) --------------------------------------------
# console.groq.com -> API Keys. Without this the pipeline runs scripted /
# deterministic fallbacks only; it does not crash.
#
# Model availability differs per account -- verify with client.models.list()
# before assuming an id exists. llama-3.3-70b-versatile is NOT available on
# current free-tier keys.
GROQ_API_KEY=
# Judgement agents: triage, arbiter.
GROQ_MODEL=openai/gpt-oss-120b
# High-volume agents: advocates, narrator. ~2x the tokens/sec.
GROQ_MODEL_FAST=openai/gpt-oss-20b

# --- Admin portal login (memory_draft.md section 7.6) ----------------------
# Demo-grade static credentials. Real auth is post-hackathon work.
PACT_ADMIN_USER=admin
PACT_ADMIN_PASS=pact-admin

# --- Demo dials ------------------------------------------------------------
# autopilot=false makes the admin gate wait for a human instead of approving
# on timeout. Ship it true so the demo never stalls; flip it live to show
# human-in-the-loop control.
AUTOPILOT=true
GATE_TIMEOUT_S=25

# Slows event emission so the deliberation is readable on stage. 0 = full
# speed. With Groq streaming at ~275 tok/s the risk is being too fast to follow.
DEMO_LATENCY_MS=0
